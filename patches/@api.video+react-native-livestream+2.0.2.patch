diff --git a/node_modules/@api.video/react-native-livestream/ios/ScoreOverlayEffect.swift b/node_modules/@api.video/react-native-livestream/ios/ScoreOverlayEffect.swift
new file mode 100644
index 0000000..56f7e43
--- /dev/null
+++ b/node_modules/@api.video/react-native-livestream/ios/ScoreOverlayEffect.swift
@@ -0,0 +1,85 @@
+//
+//  ScoreOverlayEffect.swift
+//
+//  Draws a two-team score banner in the top-left corner of every video frame
+//  before it is encoded, so viewers of the stream see it.
+//
+
+import AVFoundation
+import CoreImage
+import HaishinKit
+import UIKit
+
+final class ScoreOverlayEffect: VideoEffect {
+    private let lock = NSLock()
+    private var banner: CIImage?
+
+    /// Re-renders the banner. Call from any thread.
+    func update(team1: String, team2: String, score1: Int, score2: Int) {
+        let image = ScoreOverlayEffect.render(team1: team1, team2: team2, score1: score1, score2: score2)
+        lock.lock()
+        banner = image
+        lock.unlock()
+    }
+
+    override func execute(_ image: CIImage, info _: CMSampleBuffer?) -> CIImage {
+        lock.lock()
+        let banner = self.banner
+        lock.unlock()
+        guard let banner = banner else { return image }
+
+        let extent = image.extent
+        // Portrait frames are narrow, so the banner takes a larger share of the width.
+        let widthRatio: CGFloat = extent.width < extent.height ? 0.55 : 0.32
+        let scale = (extent.width * widthRatio) / banner.extent.width
+        let margin = extent.width * 0.03
+        let scaled = banner.transformed(by: CGAffineTransform(scaleX: scale, y: scale))
+        // Core Image's origin is bottom-left.
+        let moved = scaled.transformed(by: CGAffineTransform(
+            translationX: extent.minX + margin,
+            y: extent.maxY - margin - scaled.extent.height
+        ))
+        return moved.composited(over: image)
+    }
+
+    private static func render(team1: String, team2: String, score1: Int, score2: Int) -> CIImage? {
+        let size = CGSize(width: 720, height: 130)
+        let renderer = UIGraphicsImageRenderer(size: size, format: {
+            let format = UIGraphicsImageRendererFormat()
+            format.scale = 1
+            format.opaque = false
+            return format
+        }())
+
+        let image = renderer.image { _ in
+            UIColor(white: 0, alpha: 0.72).setFill()
+            UIBezierPath(roundedRect: CGRect(origin: .zero, size: size), cornerRadius: 28).fill()
+
+            func draw(_ text: String, in rect: CGRect, font: UIFont, align: NSTextAlignment) {
+                let style = NSMutableParagraphStyle()
+                style.alignment = align
+                style.lineBreakMode = .byTruncatingTail
+                let attributed = NSAttributedString(string: text, attributes: [
+                    .font: font,
+                    .foregroundColor: UIColor.white,
+                    .paragraphStyle: style,
+                ])
+                let height = attributed.size().height
+                attributed.draw(in: CGRect(x: rect.minX, y: rect.midY - height / 2, width: rect.width, height: height))
+            }
+
+            let nameFont = UIFont.systemFont(ofSize: 40, weight: .semibold)
+            let scoreFont = UIFont.systemFont(ofSize: 70, weight: .heavy)
+            let centerWidth: CGFloat = 200
+            let padding: CGFloat = 24
+            let nameWidth = (size.width - centerWidth - padding * 2) / 2
+
+            draw(team1, in: CGRect(x: padding, y: 0, width: nameWidth, height: size.height), font: nameFont, align: .right)
+            draw("\(score1) - \(score2)", in: CGRect(x: padding + nameWidth, y: 0, width: centerWidth, height: size.height), font: scoreFont, align: .center)
+            draw(team2, in: CGRect(x: padding + nameWidth + centerWidth, y: 0, width: nameWidth, height: size.height), font: nameFont, align: .left)
+        }
+
+        guard let cgImage = image.cgImage else { return nil }
+        return CIImage(cgImage: cgImage)
+    }
+}
